  "byTab": {
    "workOrders": {
      "taskTypeValue": "Planned",
      "taskTypeEnabled": false,
      "extraFields": [
        "Supervisor*",
        "Responsible",
        "Inspection Templates* (disabled)",
        "Material Template",
        "Enable Tank Mixing"
      ],
      "sections": [
        "Select Plot",
        "Select Materials",
        "Select Resources",
        "Select Assets"
      ],
      "supervisorEnabled": true
    },
    "inspection": {
      "taskTypeValue": "Inspection",
      "taskTypeEnabled": false,
      "extraFields": [
        "Supervisor* (disabled)",
        "Responsible (disabled)",
        "Inspection Templates*"
      ],
      "sections": [
        "Select Plot",
        "Select Resources"
      ],
      "supervisorEnabled": false,
      "note": "No materials, assets, material template or tank mixing. Supervisor and Responsible stay disabled even though Supervisor is starred, and the posted payload carries no managerID."
    },
    "harvest": {
      "taskTypeValue": "Planned",
      "taskTypeEnabled": false,
      "extraFields": [
        "Supervisor*",
        "Responsible"
      ],
      "sections": [
        "Select Plot",
        "Select Resources",
        "Select Assets"
      ],
      "supervisorEnabled": true,
      "note": "No inspection template, material template, tank mixing or materials section."
    }
  },
  "defaults": {
    "priority": "Medium",
    "startDate": "today",
    "endDate": "today + 10 days",
    "dateFormat": "MM/DD/YYYY",
    "materialRate": 1,
    "tankMixing": false
  },
  "pickers": {
    "plots": {
      "title": "Select Plots",
      "columns": [
        "Select",
        "Crop",
        "Plot",
        "Customer Name",
        "Plot Area",
        "Operational Area",
        "Task Start Date"
      ],
      "buttons": [
        "Reset",
        "Search",
        "Save"
      ],
      "emptyState": "No Record Found",
      "note": "Selected rows show an ADHOC badge in the modal grid."
    },
    "materials": {
      "title": "Select Materials",
      "columns": [
        "Select",
        "Material"
      ],

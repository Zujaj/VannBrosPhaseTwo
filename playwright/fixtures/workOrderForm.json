{
  "_meta": {
    "capturedOn": "2026-08-26",
    "note": "What the create modal renders per tab. Field labels are verbatim."
  },
  "header": {
    "title": "Create New Work Order",
    "badge": "Planned",
    "actions": [
      "Save As",
      "Submit",
      "Close"
    ]
  },
  "commonFields": [
    "Work Order Name*",
    "WO Start Date*",
    "WO End Date*",
    "Priority*",
    "Farm*",
    "Task Type*",
    "Task*",
    "Notes"

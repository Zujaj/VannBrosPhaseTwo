          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response body",
                  "let jsonData = pm.response.json();",
                  "",
                  "// Check if token is returned",
                  "if (jsonData.access_token) {",
                  "    // Save token into Postman environment variable",
                  "    pm.environment.set(\"agrierp_fno_access_token\", jsonData.access_token);",
                  "",
                  "    // Also log expiry info if available",
                  "    // if (jsonData.expires_in) {",
                  "    //    let expiryTime = Date.now() + (jsonData.expires_in * 1000);",
                  "    //    pm.environment.set(\"token_expiry\", expiryTime);",
                  "    // }",
                  "",
                  "    console.log(\"✅ Access token stored in environment variable: agrierp_fno_access_token\");",
                  "} else {",
                  "    console.log(\"❌ No access_token found in response\");",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
